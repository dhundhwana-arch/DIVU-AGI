# DIVU AI — environment configuration
# Copy to .env and fill in. NEVER commit a real .env file.
# Every variable is read by backend/app/core/config.py with the DIVU_ prefix.

# ---------- Application ----------
DIVU_APP_NAME="DIVU AI"
DIVU_APP_ENV=development          # development | test | staging | production
DIVU_DEBUG=false
DIVU_LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
DIVU_LOG_FORMAT=console           # console | json
DIVU_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DIVU_CORS_ORIGIN_REGEX=           # e.g. https://.*\.e2b\.app for sandbox previews

# ---------- Security (REQUIRED in staging/production) ----------
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
DIVU_SECRET_KEY=
# Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
DIVU_ENCRYPTION_KEY=
DIVU_JWT_ALGORITHM=HS256
DIVU_ACCESS_TOKEN_TTL_SECONDS=900
DIVU_REFRESH_TOKEN_TTL_SECONDS=1209600
DIVU_ALLOW_PUBLIC_REGISTRATION=true     # set false in production
DIVU_PASSWORD_MIN_LENGTH=12

# ---------- Database ----------
# Production: postgresql+asyncpg://user:pass@host:5432/divu
# Development (no services needed): sqlite+aiosqlite:///./.data/divu.db
DIVU_DATABASE_URL=sqlite+aiosqlite:///./.data/divu.db
DIVU_DB_ECHO=false

# ---------- Cache / rate limiting ----------
DIVU_CACHE_BACKEND=memory          # memory | redis
DIVU_REDIS_URL=redis://localhost:6379/0
DIVU_RATE_LIMIT_ENABLED=true
DIVU_RATE_LIMIT_REQUESTS=120
DIVU_RATE_LIMIT_WINDOW_SECONDS=60
DIVU_AUTH_RATE_LIMIT_REQUESTS=10
DIVU_AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# ---------- Object storage ----------
DIVU_OBJECT_STORAGE_BACKEND=local  # local | s3
DIVU_OBJECT_STORAGE_PATH=./.data/objects
DIVU_S3_BUCKET=
DIVU_S3_REGION=
DIVU_S3_ENDPOINT_URL=              # MinIO: http://localhost:9000

# ---------- AI providers (leave blank to run fully offline with the mock provider) ----------
DIVU_OPENAI_API_KEY=
DIVU_OPENAI_BASE_URL=https://api.openai.com/v1
DIVU_ANTHROPIC_API_KEY=
DIVU_GOOGLE_API_KEY=
DIVU_DEFAULT_PROVIDER=mock         # mock | openai | anthropic | google

# ---------- Optional: frontend ----------
NEXT_PUBLIC_API_BASE_URL=/api
